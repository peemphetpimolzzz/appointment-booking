# Copy to .env before running `docker compose up`.

# Postgres credentials (used by db, api, and the test stack).
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_dev_pw
POSTGRES_DB=booking

# Host ports (DB_PORT off 5432 to avoid clashing with a local Postgres).
WEB_PORT=8080
API_PORT=8082
DB_PORT=15432
